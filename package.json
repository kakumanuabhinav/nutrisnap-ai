{
  "name": "nutrisnap-ai-fullstack-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev --prefix nutrisnap-ai/backend\" \"npm run dev --prefix nutrisnap-ai/frontend\"",
    "dev:all": "npm run dev",
    "dev:frontend": "npm run dev --prefix nutrisnap-ai/frontend",
    "dev:backend": "npm run dev --prefix nutrisnap-ai/backend",
    "build": "npm run build --prefix nutrisnap-ai/backend && npm run build --prefix nutrisnap-ai/frontend",
    "start": "npm run start --prefix nutrisnap-ai/backend",
    "migrate": "npm run migrate --prefix nutrisnap-ai/backend",
    "migrate:prod": "npm run migrate:prod --prefix nutrisnap-ai/backend",
    "migrate:neon": "npm run migrate:neon --prefix nutrisnap-ai/backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
