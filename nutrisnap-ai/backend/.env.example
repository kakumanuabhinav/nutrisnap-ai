# ==============================================================================
# NutriSnap AI Backend — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in real values. Never commit .env to Git.

# --- Server Configuration ---
PORT=4000
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS (e.g., https://nutrisnap.com,https://app.nutrisnap.com)
CORS_ORIGIN=https://your-frontend-domain.com

# --- Database Configuration (PostgreSQL) ---
# Format: postgres://username:password@hostname:5432/database_name
DATABASE_URL=postgres://nutrisnap:nutrisnap@localhost:5432/nutrisnap

# Set to true if your hosted PostgreSQL requires SSL (e.g., Neon, Supabase, Render, AWS RDS)
DATABASE_SSL=false
DB_POOL_MAX=10

# --- Authentication & Security ---
# Generate with: openssl rand -base64 32 (must be at least 32 characters long)
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
AUTH_TOKEN_TTL=7d

# --- Google Gemini AI Configuration ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Storage Configuration ---
# Options: local (stores under backend/uploads and serves statically via /uploads)
STORAGE_DRIVER=local
STORAGE_BUCKET=nutrisnap-uploads
MAX_UPLOAD_MB=8

# Public URL of the backend (e.g., https://api.yourdomain.com).
# Used to generate absolute URLs for uploaded meal images.
BACKEND_PUBLIC_URL=https://your-backend-domain.com
