# ==============================================================================
# NutriSnap AI Frontend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and set your backend API base path.
# NOTE: In Vite, only variables prefixed with VITE_ are accessible in client code.
# Never expose backend secrets, database credentials, or AI API keys here!

# Development:
# VITE_API_URL=http://localhost:4000/api

# Production (Vercel Multi-Service Project):
# When deploying frontend and backend together under one Vercel project,
# the backend service is proxied at /api on the same domain:
VITE_API_URL=/api

# Production (Separate Backend Domain):
# If your backend is deployed to a separate domain (e.g., Render, Railway, AWS):
# VITE_API_URL=https://api.yourdomain.com/api
