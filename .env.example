# ==============================================================================
# NutriSnap AI Full-Stack — Environment Variables Reference
# ==============================================================================
#
# Backend environment variables are configured in: nutrisnap-ai/backend/.env
# Frontend environment variables are configured in: nutrisnap-ai/frontend/.env
#
# Refer to the individual .env.example files or the summary below:

# ------------------------------------------------------------------------------
# Backend Configuration (nutrisnap-ai/backend/.env)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com

# PostgreSQL Connection
DATABASE_URL=postgres://nutrisnap:nutrisnap@localhost:5432/nutrisnap
DATABASE_SSL=false
DB_POOL_MAX=10

# Auth JWT Secret (at least 32 characters)
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
AUTH_TOKEN_TTL=7d

# Google Gemini Vision API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Storage
STORAGE_DRIVER=local
STORAGE_BUCKET=nutrisnap-uploads
MAX_UPLOAD_MB=8
BACKEND_PUBLIC_URL=https://your-backend-domain.com

# ------------------------------------------------------------------------------
# Frontend Configuration (nutrisnap-ai/frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=https://your-backend-domain.com/api
